# ==============================================================================
# PUERTOS DE ACCESO EXTERNO
# ==============================================================================
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443
GUACAMOLE_PORT=8080
GUACAMOLE_WEBAPP_CONTEXT=ROOT

# ==============================================================================
# BASE DE DATOS 1: NGINX PROXY MANAGER (MariaDB)
# ==============================================================================
NPM_DB_NAME=npm_db
NPM_DB_USER=npm_user
NPM_DB_PASSWORD=npm_secure_pass_2026!
NPM_DB_ROOT_PASSWORD=npm_root_secret_2026!

# ==============================================================================
# ADMINISTRADOR WEB: NGINX PROXY MANAGER (http://<IP>:81)
# ==============================================================================
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=changeme

# ==============================================================================
# BASE DE DATOS 2: APACHE GUACAMOLE (PostgreSQL)
# ==============================================================================
GUAC_DB_NAME=guacamole_db
GUAC_DB_USER=guacamole_user
GUAC_DB_PASSWORD=guac_secure_pass_2026!

# ==============================================================================
# ADMINISTRADOR WEB: APACHE GUACAMOLE (http://<IP>:8080/)
# ==============================================================================
# Usuario inicial en BD: guacadmin
# Contraseña inicial en BD: guacadmin
# (Se puede cambiar directamente en la interfaz web de Guacamole)
# ==============================================================================
INCUS_HOST=192.168.1.101
INCUS_SSH_USER=ubuntu
INCUS_SSH_PASSWORD=changeme
INCUS_TIMEOUT_MINUTES=10
INCUS_BOOT_DELAY_MS=3000
